PORT=5185
HOST=127.0.0.1
# Optional. TURN is necessary on networks where a direct WebRTC connection fails.
# These short-term credentials are sent to room participants, never put a provider API secret here.
# TURN_URLS=turn:your-relay.example.com:3478,turns:your-relay.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Set to true to require TURN (useful for testing relay connectivity).
RELAY_ONLY=false
